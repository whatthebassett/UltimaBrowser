{
  "name": "ultima-browser",
  "productName": "Ultima Browser",
  "version": "0.1.0",
  "description": "Ultima Browser — a vertical-tabs browser with a Control Palette and one-click import from Chrome, Edge, Firefox and Zen.",
  "main": "src/main/main.js",
  "author": "UltimaBass <me@ultimabass.com>",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win",
    "evs:install": "python -m pip install --upgrade castlabs-evs",
    "evs:signup": "python -m castlabs_evs.account signup",
    "evs:login": "python -m castlabs_evs.account reauth",
    "vmp-sign": "python -m castlabs_evs.vmp sign-pkg node_modules/electron/dist"
  },
  "build": {
    "appId": "com.ultimabass.ultimabrowser",
    "productName": "Ultima Browser",
    "electronDist": "node_modules/electron/dist",
    "afterSign": "build/vmp-sign.js",
    "files": [
      "src/**/*",
      "assets/**/*",
      "node_modules/sql.js/dist/sql-wasm.*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "electron": "github:castlabs/electron-releases#v44.9.3+wvcus",
    "electron-builder": "^26.18.0"
  }
}
