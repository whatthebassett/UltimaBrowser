{
  "name": "ultima-browser",
  "productName": "Ultima Browser",
  "version": "0.6.0",
  "description": "Ultima Browser — a vertical-tabs browser with a Control Palette and one-click import from Chrome, Edge, Firefox and Zen.",
  "main": "src/main/main.js",
  "author": "UltimaBass <me@ultimabass.com>",
  "license": "MIT",
  "scripts": {
    "postinstall": "node node_modules/electron/install.js",
    "start": "electron .",
    "test": "node --test --test-concurrency=1 --disable-warning=ExperimentalWarning \"test/*.test.js\"",
    "test:extensions": "node build/test-extensions.js",
    "upload-symbols": "node build/upload-symbols.js",
    "dist": "node installer/build.js",
    "dist:nsis": "electron-builder --win",
    "dist:mac": "electron-builder --mac --arm64 --publish never",
    "dmg-background": "electron build/dmg/render.js",
    "icons": "node build/make-icons.js",
    "evs:install": "python -m pip install --upgrade castlabs-evs",
    "evs:signup": "python -m castlabs_evs.account signup",
    "evs:login": "python -m castlabs_evs.account reauth",
    "vmp-sign": "python -m castlabs_evs.vmp sign-pkg node_modules/electron/dist"
  },
  "build": {
    "appId": "com.ultimabass.ultimabrowser",
    "productName": "Ultima Browser",
    "electronDist": "node_modules/electron/dist",
    "afterPack": "build/vmp-sign-mac.js",
    "afterSign": "build/vmp-sign.js",
    "files": [
      "src/**/*",
      "assets/**/*",
      "node_modules/sql.js/dist/sql-wasm.*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "icon": "assets/icon-mac.png",
      "category": "public.app-category.productivity",
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "identity": "-",
      "hardenedRuntime": false,
      "darkModeSupport": true,
      "extendInfo": {
        "NSCameraUsageDescription": "Websites you allow can use your camera.",
        "NSMicrophoneUsageDescription": "Websites you allow can use your microphone.",
        "NSLocationUsageDescription": "Websites you allow can use your location."
      }
    },
    "dmg": {
      "title": "${productName} ${version}",
      "iconSize": 96,
      "window": {
        "width": 540,
        "height": 380
      },
      "contents": [
        {
          "x": 140,
          "y": 205,
          "type": "file"
        },
        {
          "x": 400,
          "y": 205,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "nsis": {
      "artifactName": "${productName} Setup ${version} (classic).${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "electron": "github:castlabs/electron-releases#v44.9.3+wvcus",
    "electron-builder": "^26.18.0"
  }
}
